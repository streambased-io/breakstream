{
  "generators": [
    {
      "name": "reordered_perf_customers_ordered",
      "topic": "reordered_perf_customers_ordered",
      "vars": {
        "_key_seq": {
          "_gen": "sequentialInteger"
        }
      },
      "key": {
        "_gen": "string",
        "expr": "key#{_key_seq}"
      },
      "value": {
        "CustomerID": "RPC_PERF_ORDERED",
        "Name": "Reordered Perf Match",
        "Address": {
          "_gen": "string",
          "expr": "#{Address.full_address}"
        },
        "Email": {
          "_gen": "string",
          "expr": "#{Internet.email_address}"
        },
        "PhoneNo": {
          "_gen": "string",
          "expr": "#{PhoneNumber.phone_number}"
        },
        "Sequence": {
          "_gen": "sequentialInteger",
          "startingFrom": 0
        }
      },
      "localConfigs": {
        "events": {
          "exactly": 2000000
        }
      }
    }
  ],
  "connections": {
    "kafka": {
      "kind": "kafka",
      "producerConfigs": {
        "bootstrap.servers": "kafka1:9092",
        "key.serializer": "org.apache.kafka.common.serialization.StringSerializer",
        "value.serializer": "io.confluent.kafka.serializers.KafkaAvroSerializer",
        "schema.registry.url": "http://schema-registry:8081"
      }
    }
  }
}
